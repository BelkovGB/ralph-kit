# Image for isolated validation runs. The kit installs nothing project specific.
# Replace the base image with the one the project needs, for example:
#   Node:   FROM node:24-bookworm-slim
#   Python: FROM python:3.12-slim-bookworm
FROM debian:bookworm-slim

# The entrypoint commits a disposable snapshot, so git is required. Commands run
# as an unprivileged user whose uid is fixed: the runner mounts /workspace with it.
RUN apt-get update \
  && apt-get install --yes --no-install-recommends git ca-certificates \
  && useradd --system --uid 65532 --create-home ralph \
  && rm -rf /var/lib/apt/lists/*

# Project slot: copy the manifest and install dependencies here — also a database
# or a browser, if a command needs one, because the run itself has no network:
#   Node:   COPY package.json package-lock.json ./ then RUN npm ci
#   Python: COPY requirements.txt ./ then RUN pip install -r requirements.txt
#
# What the run gives the commands, and what follows from it:
#
# 1. No network, so the build is the only place with one, and the only step that
#    downloads a whole dependency tree at once. An unstable connection breaks
#    there: the runner retries the build, but every retry restarts the failed
#    layer from its beginning. Wrap the install in a retry loop inside a single
#    RUN — the package cache lives in that layer, so each pass gets further.
#
# 2. A read-only root filesystem. /workspace and /tmp are writable tmpfs paths,
#    and `validationContainer.writableVolumes` adds writable anonymous volumes
#    for caches a package manager must update. Dependencies installed here live
#    outside the workspace — /opt is the usual place — and a preflight script
#    puts them where the commands expect them. Copy them, do not link them: a
#    test runner that writes inside its own dependency tree fails on a symlink
#    into read-only /opt. That is what `preflightScripts` is for.
#
# 3. A fresh container per run, so a service with state on disk cannot be baked
#    into the image: its data directory would be read-only. Such a service is
#    initialised and started by a preflight script under /tmp.
#
# Worked examples for common stacks — a retry loop, a database, a package store —
# are in docs/tips.md of the kit repository, not here: this file belongs to your
# project and carries your stack, not someone else's.

COPY scripts/ralph/ralph-validation-entrypoint.sh /usr/local/bin/ralph-validation
COPY scripts/ralph/ralph-validation-docker-shim.sh /usr/local/bin/docker
RUN chmod 0555 /usr/local/bin/ralph-validation /usr/local/bin/docker \
  && mkdir -p /source /workspace \
  && chown 65532:65532 /source /workspace

USER 65532:65532
ENTRYPOINT ["/usr/local/bin/ralph-validation"]
